rules_version = '2';

// Правила доступа для каталога САН.
// Чтение каталога — публичное (лента работает и для гостей).
// Запись каталога — только владелец-хост (по ownerID) или админ (custom claim).
//
// Роль администратора выдаётся через кастомный claim `admin: true`
// (см. scripts/set-admin-claim.js). Раньше запись была разрешена ЛЮБОМУ
// аутентифицированному пользователю — теперь это закрыто.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Хелперы ──────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    // Админ определяется кастомным claim'ом (выдаётся серверным скриптом).
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    function uid() {
      return request.auth.uid;
    }
    // Владелец заведения (по документу venues/{venueID}).
    function isVenueOwner(venueID) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/venues/$(venueID))
        && get(/databases/$(database)/documents/venues/$(venueID)).data.ownerID == uid();
    }
    // Создаваемый/изменяемый документ принадлежит текущему хосту.
    function ownsIncoming() {
      return isSignedIn() && request.resource.data.ownerID == uid();
    }
    function ownsExisting() {
      return isSignedIn() && resource.data.ownerID == uid();
    }
    // Настоящий аккаунт (не анонимный вход — он доступен любому скрипту).
    function isRealUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    // Ссылка, которую клиенты откроют/покажут: пусто, null или https://.
    // Раньше хост мог записать `javascript:`/`http:`/`data:` в imageURL или
    // pdfMenuURL — админ-панель и клиенты открывали бы это как есть.
    function safeURL(v) {
      return v == null || v == '' || (v is string && v.size() <= 2048 && v.matches('^https://[^ ]+$'));
    }
    // Поле-ссылка допустимо в создаваемом документе.
    function urlFieldOK(field) {
      return safeURL(request.resource.data.get(field, ''));
    }
    // При правке проверяем только изменённые ссылки: старые записи с http://
    // не должны блокировать правку других полей.
    function urlFieldChangeOK(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field])
        || urlFieldOK(field);
    }

    // ── Заведения ────────────────────────────────────────────────────────
    // Читают все. Создаёт/меняет владелец (ownerID == uid) или админ.
    // При создании ownerID обязателен и должен совпадать с uid (кроме админа).
    //
    // Модерацию и витринные счётчики владелец себе не ставит (аудит 2026-10-01):
    // раньше он мог записать status: "approved", isVerified: true и любой
    // rating/reviewCount/savedByCount — а это то, по чему ранжируется лента.
    //  • status: заводится только «pending»; дальше владелец может лишь вернуть
    //    заведение на модерацию, одобряет админ. Нет поля = «одобрено» (так
    //    читают клиенты старые записи из сида), поэтому сохранение такого
    //    заведения со status: "approved" — не повышение.
    //  • isVerified: владелец может только снять.
    //  • rating/reviewCount/ratingHistogram считает recomputeVenueRating,
    //    savedByCount — сервер; ни создать, ни поменять их клиенту нельзя.
    //  • boostedUntil — платное продвижение: только сохранить как было или убрать
    //    (iOS-кабинет пишет null, когда продвижения нет).
    function venueServerFields() {
      return ['rating', 'reviewCount', 'ratingHistogram', 'savedByCount'];
    }
    function venueCreateAllowed() {
      let d = request.resource.data;
      return d.get('status', '') == 'pending'
        && d.get('isVerified', false) == false
        && d.get('boostedUntil', null) == null
        && !d.keys().hasAny(venueServerFields());
    }
    function venueUpdateAllowed() {
      let d = request.resource.data;
      let old = resource.data;
      return d.ownerID == old.ownerID
        && (d.get('status', 'approved') == old.get('status', 'approved') || d.get('status', '') == 'pending')
        && (d.get('isVerified', false) == old.get('isVerified', false) || d.get('isVerified', false) == false)
        && (d.get('boostedUntil', null) == old.get('boostedUntil', null) || d.get('boostedUntil', null) == null)
        && !d.diff(old).affectedKeys().hasAny(venueServerFields());
    }
    match /venues/{id} {
      allow read: if true;
      allow create: if isAdmin() || (ownsIncoming() && request.resource.data.ownerID is string && venueCreateAllowed()
                                     && urlFieldOK('imageURL') && urlFieldOK('pdfMenuURL'));
      allow update: if isAdmin() || (ownsExisting() && venueUpdateAllowed()
                                     && urlFieldChangeOK('imageURL') && urlFieldChangeOK('pdfMenuURL'));
      allow delete: if isAdmin() || ownsExisting();
    }

    // ── Предложения (акции) ──────────────────────────────────────────────
    // Акцию создаёт только владелец ЗАВЕДЕНИЯ акции (аудит запуска
    // 2026-10-01): раньше хватало ownerID == uid, и любой вошедший создавал
    // «акцию» от имени чужого заведения — с пушем всем его подписчикам
    // (notifyOnNewDeal). Заведение и владельца у акции не переносят.
    match /deals/{id} {
      allow read: if true;
      allow create: if isAdmin()
                    || (ownsIncoming() && request.resource.data.ownerID is string
                        && request.resource.data.venueID is string
                        && isVenueOwner(request.resource.data.venueID)
                        && urlFieldOK('imageURL'));
      allow update: if isAdmin()
                    || (ownsExisting()
                        && request.resource.data.ownerID == resource.data.ownerID
                        && request.resource.data.get('venueID', '') == resource.data.get('venueID', '')
                        && urlFieldChangeOK('imageURL'));
      allow delete: if isAdmin() || ownsExisting();
    }

    // ── Категории заведений ──────────────────────────────────────────────
    // Гибкий список, управляется только из админ-панели. Читают все.
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Отзывы ───────────────────────────────────────────────────────────
    // Читают все. Создаёт автор (authorID == uid). Менять/удалять может автор,
    // владелец заведения (ответ хоста hostReply) или админ.
    // id отзыва: `{uid}_{venueID}_{itemID}`; пустой/нет itemID → `_venue`.
    function reviewIDMatches(id) {
      let d = request.resource.data;
      let item = d.get('itemID', '');
      return (item == null || item == '')
        ? id == uid() + '_' + d.venueID + '_venue'
        : (item is string && id == uid() + '_' + d.venueID + '_' + item);
    }
    // Оценка целая 1…5, текст ≤ 2000, имя ≤ 60, фото ≤ 6.
    function reviewFieldsValid() {
      let d = request.resource.data;
      return d.rating is int && d.rating >= 1 && d.rating <= 5
        && (d.get('text', '') is string && d.get('text', '').size() <= 2000)
        && (d.get('authorName', '') is string && d.get('authorName', '').size() <= 60)
        && (d.get('photos', []) is list && d.get('photos', []).size() <= 6)
        && (d.get('photoEmojis', []) is list && d.get('photoEmojis', []).size() <= 6);
    }
    match /reviews/{id} {
      allow read: if true;
      // Автор не пишет ни ответ заведения (`hostReply`), ни отметку «был в
      // заведении» (`verifiedVisit`): раньше и то и другое подделывалось из
      // клиента — отзыв «с подтверждённым визитом» и «ответом владельца».
      //
      // Аудит запуска 2026-10-01: только настоящий аккаунт (не анонимный), один
      // отзыв на гостя × заведение × блюдо — id детерминированный:
      // `{uid}_{venueID}_{itemID}` или `{uid}_{venueID}_venue` для отзыва о
      // заведении (клиент генерирует ровно так). Повтор перезаписывает свой
      // отзыв (update), а не плодит новые — накрутка рейтинга одним аккаунтом
      // закрыта. Поля проверяются по размеру, заведение должно существовать.
      allow create: if isRealUser() && request.resource.data.authorID == uid()
                    && !request.resource.data.keys().hasAny(['hostReply'])
                    && request.resource.data.get('verifiedVisit', false) != true
                    && request.resource.data.venueID is string
                    && reviewIDMatches(id)
                    && reviewFieldsValid()
                    && exists(/databases/$(database)/documents/venues/$(request.resource.data.venueID));
      // Владелец заведения правит только свой ответ (`hostReply`), а не
      // оценку, текст или автора отзыва: раньше ему был открыт весь документ.
      // Автор не переносит отзыв на другое заведение, не меняет авторство и
      // не трогает `hostReply`/`verifiedVisit`.
      allow update: if isAdmin()
                    || (isSignedIn() && resource.data.authorID == uid()
                        && request.resource.data.authorID == resource.data.authorID
                        && request.resource.data.venueID == resource.data.venueID
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostReply', 'verifiedVisit'])
                        && reviewFieldsValid())
                    || (isVenueOwner(resource.data.venueID)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostReply']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorID == uid());
    }

    // ── Жалобы на отзывы ─────────────────────────────────────────────────
    // Guidelines 1.2: механизм жалоб на пользовательский контент.
    //
    // Создать может любой вошедший (в том числе анонимный гость) и только от
    // своего имени; id документа детерминированный — {reviewID}_{reporterID},
    // поэтому повторная жалоба перезаписывает свою же, а не засоряет очередь.
    // Читает и закрывает ТОЛЬКО админ: жалоба — это донос, её не должны видеть
    // ни автор отзыва, ни владелец заведения.
    match /reviewReports/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.reporterID == uid()
                    && request.resource.data.reviewID is string
                    && request.resource.data.reviewID.matches('^[A-Za-z0-9_-]{1,120}$')
                    && request.resource.data.venueID is string
                    && request.resource.data.venueID.size() <= 128;
    }

    // ── Личная библиотека ────────────────────────────────────────────────
    // userLibraries/{uid}: сохранённые места, избранные акции, отметки
    // «нравится» и скрытые авторы отзывов (Guidelines 1.2). Раньше всё это
    // жило только на устройстве и стиралось при выходе. Читает и пишет только
    // владелец; только известные поля, каждый список ≤ 500 (UserLibrary.maxItems).
    function libraryListOK(d, field) {
      return !(field in d) || (d[field] is list && d[field].size() <= 500);
    }
    match /userLibraries/{userID} {
      allow read, delete: if isSignedIn() && userID == uid();
      allow create, update: if isSignedIn() && userID == uid()
                    && request.resource.data.keys().hasOnly(['savedVenueIDs', 'favoriteDealIDs',
                         'likedDealIDs', 'blockedAuthorIDs', 'updatedAt'])
                    && libraryListOK(request.resource.data, 'savedVenueIDs')
                    && libraryListOK(request.resource.data, 'favoriteDealIDs')
                    && libraryListOK(request.resource.data, 'likedDealIDs')
                    && libraryListOK(request.resource.data, 'blockedAuthorIDs');
    }

    // ── Push-кампании ────────────────────────────────────────────────────
    // Хост создаёт кампанию по своему заведению ("pending"). Одобряет только
    // админ (status → approved/rejected); рассылку делает Cloud Function.
    // Кампанию создаёт любой аутентифицированный хост ("pending"); это безвредно,
    // т.к. рассылку запускает только Cloud Function ПОСЛЕ одобрения админом
    // (update разрешён только админу). Владение заведением тут проверять нельзя:
    // Android-хост не пишет venues в Firestore (только в SharedPreferences), а у
    // засеянных заведений ownerID пустой — проверка isVenueOwner их бы заблокировала.
    // Аудит запуска 2026-10-01: создаёт только владелец заведения кампании
    // (ownerID == uid), читает — свои кампании владелец или админ. Раньше
    // любой вошедший читал все кампании всех заведений и засорял очередь
    // модерации чужими заявками. Android-хост без синхронизированного
    // заведения кампанию теперь не создаст — осознанно (см. claude-notes).
    match /pushCampaigns/{id} {
      allow create: if isAdmin()
                    || (ownsIncoming()
                        && request.resource.data.venueID is string
                        && isVenueOwner(request.resource.data.venueID)
                        && request.resource.data.get('status', 'pending') == 'pending'
                        && request.resource.data.get('delivered', false) == false
                        && request.resource.data.get('headline', '') is string
                        && request.resource.data.get('headline', '').size() <= 120
                        && request.resource.data.get('body', '') is string
                        && request.resource.data.get('body', '').size() <= 400);
      allow read:   if isAdmin() || ownsExisting();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Аналитика ────────────────────────────────────────────────────────
    // Счётчики analytics/{venueID}/days/{day} — server-authoritative: пишут ТОЛЬКО
    // Cloud Functions (countAnalyticsEvent / countRedemption, admin SDK обходит
    // правила). Клиент напрямую сюда писать не может (нельзя подделать статистику).
    // Читает статистику владелец заведения или админ.
    match /analytics/{venueID}/{document=**} {
      allow read:  if isAdmin() || isVenueOwner(venueID);
      allow write: if false;
    }

    // Клиентская телеметрия: приложение создаёт событие, Cloud Function
    // countAnalyticsEvent инкрементирует счётчик и удаляет документ. Разрешаем
    // только create с известной метрикой; читать/менять/удалять клиент не может.
    match /analyticsEvents/{id} {
      allow create: if isSignedIn()
                    && request.resource.data.venueID is string
                    && request.resource.data.venueID.size() > 0
                    && request.resource.data.venueID.size() <= 128
                    && request.resource.data.metric in ['views', 'saves', 'calls', 'maps', 'dealTaps']
                    && request.resource.data.keys().hasOnly(['venueID', 'metric', 'createdAt']);
      allow read, update, delete: if false;
    }

    // Журнал ранжирования (learning-to-rank): append-only. Клиент создаёт событие
    // с фичами на момент показа и исходом (impression/tap/redeem); читает/меняет
    // только офлайн-экспорт (admin SDK). Схема — RankingEvent.swift/.kt.
    match /rankingEvents/{id} {
      allow create: if isSignedIn()
                    && request.resource.data.type in ['impression', 'tap', 'redeem']
                    && request.resource.data.sessionID is string
                    && request.resource.data.userID == uid()
                    && (!('items' in request.resource.data)
                        || (request.resource.data.items is list && request.resource.data.items.size() <= 30));
      allow read, update, delete: if false;
    }

    // Публичный конфиг (напр. config/rankingWeights — веса выдачи, обученные офлайн).
    // Читают все (лента работает и для гостей). Пишет только админ/скрипт публикации
    // (ml/publish_ranking_weights.js через admin SDK обходит правила).
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Профили хостов ───────────────────────────────────────────────────
    // Читают аутентифицированные (приложение показывает статус верификации).
    // Пишет хост свой профиль (uid == документ). Статус верификации — строковое
    // поле `verification` (none|pending|verified|rejected). Хост может лишь
    // ЗАПРОСИТЬ верификацию (none/pending); выставить verified/rejected — только
    // админ. Уже верифицированный хост может править прочие поля, не трогая статус.
    // Чтение — только свой профиль или админ (аудит запуска 2026-10-01):
    // в профиле телефон, ИНН/документы заявки на проверку. Гостевое
    // приложение чужие профили не читает (статус проверки — `venues.isVerified`).
    match /hosts/{hostUid} {
      allow read: if isAdmin() || (isSignedIn() && hostUid == uid());
      allow create: if isAdmin()
                    || (isSignedIn() && hostUid == uid()
                        && request.resource.data.get('verification', 'none') in ['none', 'pending']);
      allow update: if isAdmin()
                    || (isSignedIn() && hostUid == uid()
                        && (request.resource.data.get('verification', 'none') == resource.data.get('verification', 'none')
                            || request.resource.data.get('verification', 'none') in ['none', 'pending']));
      allow delete: if isAdmin();
    }

    // ── Купоны заведения (продаются за бонусы) ───────────────────────────
    // Заведение само выпускает купон и назначает цену — оно и несёт расход.
    // Но три поля ему не принадлежат:
    //   `soldCount` считает сервер при покупке (`buyCoupon`); запись с клиента
    //   затёрла бы чужие покупки своим устаревшим числом;
    //   `status` — модерация: иначе заведение одобряло бы себя само, как и с
    //   `venues` (и с `hosts.verification`);
    //   `ownerID` менять нельзя — это передача купона чужому аккаунту.
    // Читают все: каталог купонов открыт, как и каталог акций. Невыставленные
    // (pending/paused) отсеивает клиент — они не секрет, а просто не в продаже.
    match /couponOffers/{id} {
      allow read: if true;
      // Заведение купона — своё: купон гасится у стойки из `venueID`, и
      // купон на чужое заведение — это продажа чужого товара. Сменить
      // заведение у выпущенного купона нельзя (иначе одобренный купон
      // перенацеливается на конкурента мимо модерации). buyCoupon проверяет
      // то же самое на сервере.
      allow create: if isAdmin()
                    || (ownsIncoming()
                        && request.resource.data.ownerID is string
                        && request.resource.data.get('soldCount', 0) == 0
                        && request.resource.data.get('status', 'pending') == 'pending'
                        && urlFieldOK('imageURL')
                        && exists(/databases/$(database)/documents/venues/$(request.resource.data.venueID))
                        && get(/databases/$(database)/documents/venues/$(request.resource.data.venueID)).data.ownerID == uid());
      // Статус меняет только модерация — с одним исключением: владелец может
      // вернуть купон на модерацию (`pending`). А правка того, что видит и
      // покупает гость (цена, название, описание, эмодзи, фото), у ОДОБРЕННОГО
      // купона обязана это сделать: иначе одобренный «Капучино за 120» тихо
      // становился «чем угодно за 1» мимо модерации.
      allow update: if isAdmin()
                    || (ownsExisting()
                        && request.resource.data.ownerID == resource.data.ownerID
                        && request.resource.data.venueID == resource.data.venueID
                        && request.resource.data.get('soldCount', 0) == resource.data.get('soldCount', 0)
                        && urlFieldChangeOK('imageURL')
                        && (request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending')
                            || request.resource.data.get('status', 'pending') == 'pending')
                        && (resource.data.get('status', 'pending') != 'approved'
                            || !request.resource.data.diff(resource.data).affectedKeys()
                                  .hasAny(['cost', 'title', 'details', 'emoji', 'imageURL'])
                            || request.resource.data.get('status', 'pending') == 'pending'));
      allow delete: if isAdmin() || ownsExisting();
    }

    // ── Instagram заведения ──────────────────────────────────────────────
    // igAccounts держит ТОКЕН ДОСТУПА к инстаграму заведения — клиенту он не
    // нужен ни для чего: за постами хост ходит через Cloud Functions по своему
    // Firebase-токену. Поэтому документ закрыт целиком, а не «только на запись»:
    // утёкший токен — это чужой аккаунт в чужих руках, правилами не откатишь.
    match /igAccounts/{id} {
      allow read, write: if false;
    }

    // Публичная половина того же подключения: имя аккаунта, дата, флаг
    // «нужен повторный вход». Её хост слушает снапшотом, чтобы кабинет
    // обновился сразу после возврата из браузера. Пишут только функции.
    match /igConnections/{id} {
      allow read:  if isSignedIn() && resource.data.ownerID == uid();
      allow write: if false;
    }

    // Одноразовый `state` OAuth. Читаемый клиентом state — это возможность
    // привязать свой инстаграм к чужому заведению, поэтому закрыт полностью.
    match /igAuthStates/{nonce} {
      allow read, write: if false;
    }

    // ── Токены списания баллов (QR AYANT-RDT) и троттлинг пушей ──────────
    // Пишут и читают только Cloud Functions (issueRedeemToken /
    // redeemVenuePoints, notifyOnNewDeal / notifyHostOnReview). Токен — это
    // право списать чужие баллы: клиенту ни прочитать, ни подделать его нельзя.
    match /redeemTokens/{token} {
      allow read, write: if false;
    }
    match /pushThrottle/{id} {
      allow read, write: if false;
    }

    // ── Служебные документы (ops) ────────────────────────────────────────
    // Пульсы задач и алерты целостности баллов (reconcileVenuePoints).
    // Пишет только Cloud Function (admin SDK обходит правила); читает админ —
    // чтобы расхождения можно было посмотреть в панели, не открывая логи.
    match /ops/{doc=**} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── FCM-токены пользователей ─────────────────────────────────────────
    // Токен можно записать только на себя: раньше любой вошедший мог
    // записать документ с чужим uid и получать адресные пуши этого человека
    // (сгорание баллов с балансом, ответы на отзывы). Документ без uid
    // (аудит запуска 2026-10-01) больше не создаётся: такие записи были
    // анонимным мусором, который никто не мог ни адресовать, ни удалить.
    // Обновление старого документа без uid — только с проставлением своего.
    // Удалить — свой или ничей (выход из аккаунта удаляет свой).
    match /userTokens/{token} {
      allow create: if isSignedIn() && request.resource.data.get('uid', '') == uid();
      allow update: if isSignedIn() && request.resource.data.get('uid', '') == uid();
      allow delete: if isSignedIn() && (!('uid' in resource.data) || resource.data.uid == uid());
      allow read: if false;
    }

    // ── Погашения купонов ────────────────────────────────────────────────
    // Пользователь создаёт документ (id = uid_dealID). Счётчик и пометку
    // "counted" делает Cloud Function (admin SDK обходит правила).
    // Документ привязан к автору: userID — это uid вызывающего, а id — ровно
    // uid_dealID (так его пишут оба клиента: FirebaseServices.logRedemption /
    // FirebaseDataRepository.logRedemption). Иначе любой вошедший мог бы
    // накрутить «Погашено» чужому заведению через countRedemption.
    match /redemptions/{id} {
      allow create: if isSignedIn()
        && request.resource.data.userID == uid()
        && request.resource.data.dealID is string
        && request.resource.data.venueID is string
        && id == uid() + '_' + request.resource.data.dealID
        // Счётчик погашений — витрина заведения: погашение засчитывается
        // только для настоящей акции этого заведения (раньше подходила любая
        // строка, и любой вошедший накручивал счётчик чужому заведению).
        && exists(/databases/$(database)/documents/deals/$(request.resource.data.dealID))
        && get(/databases/$(database)/documents/deals/$(request.resource.data.dealID)).data.venueID
             == request.resource.data.venueID;
      allow read, update, delete: if false;
    }

    // ── Рефералы ─────────────────────────────────────────────────────────
    // Только настоящий аккаунт: анонимный вход доступен любому скрипту, и
    // реферал с него был бы бонусами без человека. rewardReferral проверяет то
    // же самое на сервере (и новизну аккаунта) — правило лишь отсекает раньше.
    match /referrals/{inviteeID} {
      allow create: if isSignedIn() && uid() == inviteeID
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.referrerID is string
                    && request.resource.data.referrerID != uid();
      allow read, update, delete: if false;
    }

    // ── Серверные бонусы ─────────────────────────────────────────────────
    // Начисление (create) делает только Cloud Function rewardReferral (admin SDK).
    // Клиент вправе лишь «забрать» грант — перевести claimed false→true, НЕ трогая
    // сумму/причину. Раньше update не пинил amount/reason и не запрещал обратный
    // переход claimed→false: пользователь мог накрутить свой же грант (amount:999999)
    // или переполучить его. Теперь update — это ровно одноразовое погашение.
    match /bonusGrants/{id} {
      allow read: if isSignedIn() && resource.data.userID == uid();
      allow update: if isSignedIn() && resource.data.userID == uid()
                    && request.resource.data.userID == resource.data.userID
                    && request.resource.data.amount == resource.data.amount
                    && request.resource.data.get('reason', '') == resource.data.get('reason', '')
                    && resource.data.get('claimed', false) == false
                    && request.resource.data.claimed == true;
      allow create, delete: if false;
    }

    // ── Подарочные купоны ────────────────────────────────────────────────
    // Купон адресуется по коду-ссылке (без uid получателя). Забрать можно РОВНО
    // один раз: update разрешён только как переход claimed false→true и без
    // подмены остального содержимого — иначе купон можно было бы «перезабрать».
    // Подарки создаёт buyCoupon (списав бонусы дарителя), забирает claimGift
    // (создавая купон заведения). Клиенту — только прочитать подарок по коду
    // из ссылки: `list` закрыт, иначе любой выгрузил бы все незабранные коды.
    // Раньше клиент и создавал подарок (любые поля), и забирал его сам.
    match /giftCoupons/{code} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if false;
    }

    // ── Купоны пользователя (анти-чит) ───────────────────────────────────
    // Пометку used ставит только Cloud Function scanCoupon (admin SDK).
    // Купон, привязанный к заведению, гасится у стойки (scanCoupon) — то есть
    // это настоящий товар. Такие купоны создаёт ТОЛЬКО сервер: buyCoupon
    // (за бонусы) и scanCoupon (награда карты штампов). Раньше клиент мог
    // записать купон с любым venueID напрямую — без единого бонуса. Клиенту
    // оставлены только непривязанные купоны старых сборок: их не погасить.
    match /coupons/{id} {
      allow read:   if isSignedIn() && resource.data.userID == uid();
      allow create: if isSignedIn() && request.resource.data.userID == uid()
                    && request.resource.data.used == false
                    && request.resource.data.get('venueID', '') == '';
      allow update, delete: if false;
    }

    // ── Кошелёк бонусов (глобальный) ─────────────────────────────────────
    // Баланс и ledger пишут только функции (bonusWalletSync / earnBonus /
    // buyCoupon). Владелец читает свой баланс снапшот-листенером.
    match /bonusWallets/{userID} {
      allow read: if isSignedIn() && userID == uid();
      allow write: if false;
      match /{sub=**} {
        allow read, write: if false;
      }
    }

    // ── Карты лояльности ─────────────────────────────────────────────────
    match /loyaltyCards/{id} {
      allow read:  if isSignedIn() && resource.data.userID == uid();
      allow write: if false;
      // Ключи идемпотентности скана (scanCoupon). Пишет только Cloud Function;
      // клиенту незачем ни читать, ни писать — подделка ключа позволила бы
      // «воспроизвести» чужой штамп.
      match /scanKeys/{key} {
        allow read, write: if false;
      }
    }

    // Дополнительные карты штампов заведения ({userID}_{venueID}_{cardID}).
    // Отдельная коллекция, чтобы клиенты, читающие `loyaltyCards` по userID и
    // склеивающие карты по заведению (Android, старые iOS), их не видели.
    // Права — те же: гость читает свои, пишет только Cloud Function.
    match /extraLoyaltyCards/{id} {
      allow read:  if isSignedIn() && resource.data.userID == uid();
      allow write: if false;
      match /{sub=**} {
        allow read, write: if false;
      }
    }

    // ── Баллы САН (per-venue ledger) ─────────────────────────────────────
    // Кошелёк баллов заведения. Начисление/списание/сгорание — ТОЛЬКО Cloud
    // Functions (scanCoupon Ветка C / redeemVenuePoints / expireVenuePoints,
    // admin SDK обходит правила). Клиент только читает свою карту и её историю
    // (ledger) — счётчики баллов подделать нельзя (это деньги заведения).
    match /venuePoints/{cardId} {
      allow read:  if isSignedIn() && resource.data.userID == uid();
      allow write: if false;
      // Владелец — по id карты (`{userID}_{venueID}`), а не через get() карты:
      // у гостя, ещё не получавшего баллы в этом заведении, карты нет, get()
      // падает, и Firestore отклонял весь запрос — экран истории показывал
      // «Нет доступа к истории этого аккаунта» вместо пустой истории.
      // UID Firebase — только буквы и цифры, так что префикс однозначен.
      match /ledger/{txnId} {
        allow read: if isSignedIn() && cardId.matches(uid() + '_.+');
        allow write: if false;
      }
      // Ключи идемпотентности списания (redeemVenuePoints). Пишет только
      // Cloud Function; клиенту незачем ни читать, ни писать — подделка ключа
      // позволила бы «воспроизвести» чужое списание.
      match /redeemKeys/{key} {
        allow read, write: if false;
      }
      // Ключи идемпотентности начисления (scanCoupon, ветка C).
      match /scanKeys/{key} {
        allow read, write: if false;
      }
    }
  }
}
