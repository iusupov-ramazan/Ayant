    "NSCameraUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to scan guests' coupon QR codes and add loyalty stamps."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера коноктордун купондорунун QR-коддорун сканерлеп, лоялдуулук штамптарын кошуу үчүн керек."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера нужна, чтобы сканировать QR-коды купонов гостей и начислять штампы лояльности."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayant shows how far nearby venues are from you."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayant жакын жайгашкан мекемелерге чейинки аралыкты көрсөтөт."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayant показывает расстояние до заведений рядом с вами."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To save the gift image to your Photos."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Белектин сүрөтүн Сүрөттөргө сактоо үчүн."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы сохранить картинку подарка в фото."
