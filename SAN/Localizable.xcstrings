    "«%@» за %lld бонусов. Купон нельзя вернуть после обмена." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” for %lld bonuses. The coupon cannot be returned after the exchange."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%1$@» — %2$lld бонуска. Алмашкандан кийин купонду кайтарууга болбойт."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "«%1$@» за %2$lld бонусов. Купон нельзя вернуть после обмена."
          }
        }
      }
    },
    "«%@» и все его предложения будут удалены без возможности восстановления." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” and all its deals will be deleted permanently."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» жана анын бардык сунуштары калыбына келтирүү мүмкүнчүлүгүсүз өчүрүлөт."
          }
        }
      }
    },
    "(%lld)" : {
      "localizations" : {
