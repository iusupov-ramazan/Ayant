    "«%@» в «%@» за %lld бонусов. Купон нельзя вернуть после обмена." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” at “%2$@” for %3$#@n@. The coupon can't be returned after the exchange."
          },
          "substitutions" : {
            "n" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg bonus"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg bonuses"
                    }
                  }
                }
              }
            }
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%2$@» мекемесинде «%1$@» — %3$lld бонуска. Алмашкандан кийин купонду кайтарууга болбойт."
          }
        },
