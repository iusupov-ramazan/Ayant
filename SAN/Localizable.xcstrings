    },
    "Штампов из %lld" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stamps of %lld"
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%lld штамптан"
          }
        }
      }
    },
    "Штампы или баллы САН копятся у вас и тратятся у вас. Это единственный механизм, который возвращает гостя именно к вам." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stamps or SAN points are earned at your venue and spent there. It is the one mechanic that brings guests back to you."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Штамптар же САН упайлары сизде топтолуп, сизде жумшалат. Бул конокту дал сизге кайтарган жалгыз механизм."
          }
        }
      }
    },
    "экономия %lld сом" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "save %lld som"
          }
        },
        "ky" : {
          "stringUnit" : {
