      }
    },
    "Срок купона истёк %@ — погасить его уже нельзя" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expired on %@ — it can no longer be redeemed"
          }
