# Конфигурация Cloud Functions. Реальные значения — в functions/.env (не в гите).
# Секреты здесь НЕ живут: они в Secret Manager (firebase functions:secrets:set).

# --- Apple Wallet (.pkpass) ---
WALLET_CONFIGURED=0
PASS_TYPE_ID=pass.com.example.loyalty
PASS_TEAM_ID=
PASS_ORG_NAME=Ayant
# PASS_KEY_PASSPHRASE — пароль ключа подписи, задаётся секретом, не здесь.

# --- Instagram: импорт постов в акции ---
# ID приложения Instagram (не Facebook!) — раздел «API setup with Instagram
# business login» в консоли Meta. Публичное значение.
INSTAGRAM_APP_ID=
# Должен ПОБУКВЕННО совпадать с OAuth redirect URI в Business login settings.
INSTAGRAM_REDIRECT_URI=https://us-central1-<project>.cloudfunctions.net/instagramAuthCallback
# Куда вернуть браузер после входа: схема приложения — её ловит
# ASWebAuthenticationSession в кабинете хоста.
INSTAGRAM_RETURN_URL=san://ig/connected
# INSTAGRAM_APP_SECRET — ТОЛЬКО в Secret Manager:
#   firebase functions:secrets:set INSTAGRAM_APP_SECRET

# --- Необязательное ---
# APPCHECK_MODE=off|monitor|enforce   (для onRequest-функций)
# PUSH_DAILY_CAP / PUSH_WEEKLY_CAP    (частотные лимиты push, только для тестов)
