    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.60",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.0",
    "passkit-generator": "^3.3.0"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^20.19.43",
    "proxyquire": "^2.1.3",
    "typescript": "^5.9.3"
  }
}
